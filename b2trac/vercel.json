{
  "name": "B2TRAC",
  "version": 2,
  "projectSettings": {
    "projectName": "B2TRAC",
    "framework": "nextjs"
  },
  "env": {
    "NEXT_PUBLIC_APP_NAME": {
      "description": "Nombre de la aplicación",
      "default": "B2TRAC"
    }
  },
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/",
      "statusCode": 307
    }
  ]
}
