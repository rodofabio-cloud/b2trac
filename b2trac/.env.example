# B2TRAC - Variables de Entorno Template
# Copia este archivo a .env.local y completa con tus valores

# ============================================================
# SUPABASE CONFIGURATION (REQUERIDO)
# ============================================================
# Obtén estos valores en: https://supabase.com → Tu Proyecto → Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# TENANT CONFIGURATION (Identificador único por cliente)
# ============================================================
# ID único para este cliente/empresa
NEXT_PUBLIC_TENANT_ID=default

# ============================================================
# COMPANY BRANDING (Personalización por Cliente)
# ============================================================
# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME=B2TRAC

# Datos de la empresa
NEXT_PUBLIC_COMPANY_NAME=Tu Empresa S.A.
NEXT_PUBLIC_COMPANY_RUT=XX.XXX.XXX-X
NEXT_PUBLIC_COMPANY_EMAIL=contacto@empresa.com
NEXT_PUBLIC_COMPANY_PHONE=+56 2 1234 5678
NEXT_PUBLIC_COMPANY_WEBSITE=www.empresa.com
NEXT_PUBLIC_COMPANY_ADDRESS=Calle Principal 123, Santiago, Chile

# ============================================================
# THEME COLORS (Personalización de Colores)
# ============================================================
# Color primario (botones, links, headers)
NEXT_PUBLIC_PRIMARY_COLOR=#007bff

# Color de éxito (confirmación, entregado)
NEXT_PUBLIC_SUCCESS_COLOR=#28a745

# Color de advertencia (pendiente, preparación)
NEXT_PUBLIC_WARNING_COLOR=#ffc107

# Color de peligro/error
NEXT_PUBLIC_DANGER_COLOR=#dc3545

# Color secundario
NEXT_PUBLIC_SECONDARY_COLOR=#6c757d

# Color de información
NEXT_PUBLIC_INFO_COLOR=#17a2b8

# ============================================================
# FEATURES (Habilitar/Deshabilitar Funcionalidades)
# ============================================================
# Nota: Actualmente todas están hardcodeadas como true
# En futuras versiones, se pueden controlar por variable

# NEXT_PUBLIC_ALLOW_FILE_UPLOAD=true
# NEXT_PUBLIC_ALLOW_EXCEL_DOWNLOAD=true
# NEXT_PUBLIC_ALLOW_DARK_MODE=false
# NEXT_PUBLIC_MULTI_LANGUAGE=false

# ============================================================
# INSTRUCCIONES
# ============================================================
# 1. Copiar este archivo a .env.local
# 2. Completar valores de Supabase
# 3. Personalizar datos de empresa
# 4. Ajustar colores según branding cliente
# 5. NO SUBIR .env.local a Git (está en .gitignore)

# Para ambiente de producción (Vercel):
# Agregar estas variables en:
# Vercel Dashboard → Project → Settings → Environment Variables
